generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(cuid())
  displayName String
  username    String     @unique
  bio         String?
  avatarUrl   String?
  locale      String     @default("en")
  createdAt   DateTime   @default(now())
  wishlists   Wishlist[]

  @@index([createdAt])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  title     String
  slug      String         @unique
  isPublic  Boolean        @default(true)
  theme     String         @default("warm")
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]

  @@index([createdAt])
}

model WishlistItem {
  id           String   @id @default(cuid())
  wishlistId   String
  title        String
  description  String?
  imageUrl     String?
  amazonUrl    String
  affiliateUrl String?
  marketplace  String
  priceDisplay String?
  priority     String   @default("medium")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  wishlist     Wishlist @relation(fields: [wishlistId], references: [id])
  clicks       OutboundClickEvent[]

  @@index([wishlistId, isActive])
  @@index([createdAt])
}

model OutboundClickEvent {
  id             String   @id @default(cuid())
  wishlistItemId String
  wishlistSlug   String
  marketplace    String
  referrer       String?
  userAgent      String?
  countryCode    String?
  createdAt      DateTime @default(now())
  wishlistItem   WishlistItem @relation(fields: [wishlistItemId], references: [id])

  @@index([createdAt])
}
