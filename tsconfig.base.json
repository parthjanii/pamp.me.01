{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pamperme/types": ["packages/types/src"],
      "@pamperme/api-client": ["packages/api-client/src"],
      "@pamperme/ui-tokens": ["packages/ui-tokens/index.ts"]
    }
  }
}
